# Sieve Workspace Environment Variables
# Copy this file to .env and fill in your keys. .env is ignored by Git.

# --- Google Gemma 4 / Gemini API ---
# Used for Sieve Visual Intelligence (multimodal architecture analysis with gemma-4-26b-a4b-it)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMMA_API_KEY=

# Fallback Gemini key (if GEMMA_API_KEY is not set)
GEMINI_API_KEY=

# --- GitHub API (Optional, for higher rate limits) ---
# GITHUB_TOKEN=ghp_...

# --- Local Ollama (Optional, for offline intent checks) ---
# OLLAMA_URL=http://localhost:11434
# SIEVE_MODEL=qwen3.5:9b

